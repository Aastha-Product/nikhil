# Copy this file to .env.local and fill in every value. Never commit .env.local.
# Add the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → Get API key
GEMINI_API_KEY=
# Any Flash model your key can call (check aistudio.google.com/rate-limit)
GEMINI_MODEL=gemini-flash-latest

# GitHub → Settings → Developer settings → Personal access tokens (fine-grained, public read-only)
GITHUB_TOKEN=

# Any long random string. Vercel Cron sends it automatically; you use it for manual runs.
CRON_SECRET=
